{
  "framework": null,
  "installCommand": "npm install --prefix api --omit=dev --no-audit --no-fund",
  "buildCommand": "",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/e/:day/:id",
      "destination": "/api/event?day=:day&id=:id"
    },
    {
      "source": "/s/:cat",
      "destination": "/api/section?cat=:cat"
    },
    {
      "source": "/latest",
      "destination": "/api/section"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/about",
      "destination": "/api/about"
    }
  ],
  "redirects": [
    {
      "source": "/elections-2026",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/elections",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bchirot",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/home.js": {
      "includeFiles": "public/app.html"
    },
    "api/push-tick.js": {
      "maxDuration": 60
    }
  }
}
